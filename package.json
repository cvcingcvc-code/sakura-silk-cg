{
  "name": "sakura-silk-cg",
  "version": "1.0.0",
  "description": "High-fidelity Japanese 3D Anime CG character reconstruction, custom GLSL normal/SSS relighting, sub-pixel facial rig & 8s 24fps cinematic rendering pipeline built with Three.js.",
  "main": "scripts/serve.js",
  "scripts": {
    "start": "node scripts/serve.js",
    "build:assets": "python scripts/build_3d_assets.py",
    "render:preview": "node scripts/render_runner.js preview 1440",
    "render:video": "node scripts/render_runner.js video 1080 0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/cvcingcvc-code/sakura-silk-cg.git"
  },
  "keywords": [
    "threejs",
    "webgl",
    "glsl",
    "anime-3d",
    "cg-rendering",
    "subsurface-scattering"
  ],
  "license": "MIT",
  "dependencies": {
    "three": "^0.187.0"
  }
}
